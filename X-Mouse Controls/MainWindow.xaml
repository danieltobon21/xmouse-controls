<Window
    x:Class="XMouseControls.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:XMouseControls"
    Title="TobonMouse"
    ResizeMode="CanMinimize"
    SizeToContent="WidthAndHeight"
    Loaded="Window_Loaded"
    Closing="Window_Closing"
    Topmost="True"
    Margin="3"
    WindowStartupLocation="CenterScreen"
    Icon="pack://application:,,,/Resources/tobonmouse.ico">
    <StackPanel
        VerticalAlignment="Center"
        Margin="20"
        Width="380">
        <CheckBox
            Name="trackingCheckbox"
            Margin="3"
            IsChecked="{Binding IsTrackingEnabled}"
            ToolTip="También conocido como x-mouse, o «focus follows mouse».">
            Activar el seguimiento de ventanas
        </CheckBox>

        <CheckBox
            Name="raisingCheckbox"
            Margin="3"
            IsEnabled="{Binding ElementName=trackingCheckbox, Path=IsChecked}"
            IsChecked="{Binding IsRaisingEnabled}"
            ToolTipService.ShowOnDisabled="true"
            ToolTip="Trae automáticamente al frente la ventana enfocada.">
            Activar traer-al-frente (raising)
        </CheckBox>

        <Slider
            Name="delaySlider"
            Margin="3"
            SmallChange="10"
            LargeChange="50"
            Minimum="{x:Static local:WindowTrackingValues.MinimumDelay}"
            Maximum="{x:Static local:WindowTrackingValues.MaximumDelay}"
            TickPlacement="BottomRight"
            TickFrequency="100"
            Value="{Binding Delay}"
            IsEnabled="{Binding ElementName=trackingCheckbox, Path=IsChecked}" />
        <StackPanel
            Orientation="Horizontal"
            HorizontalAlignment="Center">
            <Label>
                Retardo
            </Label>

            <TextBox
                Name="delayTextbox"
                Margin="3"
                Width="50"
                TextChanged="delayTextbox_TextChanged"
                IsEnabled="{Binding ElementName=trackingCheckbox, Path=IsChecked}"
                Text="{Binding Delay, StringFormat=0}" />

            <Label
                ToolTip="Milisegundos.">
                ms
            </Label>
        </StackPanel>

        <CheckBox
            Name="startWithWindowsCheckbox"
            Margin="3"
            ToolTip="Añade TobonMouse al arranque de Windows. Se inicia en la bandeja, sin abrir esta ventana."
            Checked="startWithWindowsCheckbox_Changed"
            Unchecked="startWithWindowsCheckbox_Changed">
            Iniciar con Windows (queda en la bandeja)
        </CheckBox>

        <Button
            Name="applyButton"
            Click="applyButton_Click"
            Margin="3">
            Aplicar
        </Button>

        <Expander
            Header="Información"
            Margin="3">
            <StackPanel
                VerticalAlignment="Center">
                <TextBlock
                    TextWrapping="WrapWithOverflow"
                    Margin="3">
                    Ajusta el comportamiento <Run FontWeight="Bold">x-mouse</Run> de Windows: la ventana bajo el ratón recibe el foco sin necesidad de hacer clic. En Unix y Linux se conoce como «focus follows mouse».
                </TextBlock>

                <TextBlock
                    TextWrapping="WrapWithOverflow"
                    Margin="3">
                    El retardo recomendado es de 100—300 ms, para que algunos menús y ventanas no desaparezcan antes de recibir el foco.
                </TextBlock>

                <TextBlock
                    TextWrapping="WrapWithOverflow"
                    Margin="3">
                    Basta con ejecutar el programa una vez: los cambios se guardan al instante. La ventana se queda arriba para no colarse debajo de otras, y al cerrarla pasa a la bandeja (doble clic para volver a abrirla, clic derecho para salir).
                </TextBlock>

                <TextBlock
                    TextWrapping="WrapWithOverflow"
                    Margin="3">
                    <Run FontWeight="Bold">TobonMouse</Run>: build propia basada en X-Mouse Controls, la utilidad creada por

                    <Hyperlink
                        NavigateUri="https://joelpurra.com/"
                        TargetName="_blank"
                        RequestNavigate="Hyperlink_RequestNavigate">
                        Joel Purra
                    </Hyperlink>.

                    <LineBreak />

                    <Run
                        ToolTip="2007—2023">
                        Copyright
                    </Run>

                    <Hyperlink
                        NavigateUri="https://www.gnu.org/licenses/gpl.html"
                        TargetName="_blank"
                        RequestNavigate="Hyperlink_RequestNavigate"
                        ToolTip="Distribuido bajo la GNU General Public License (GPL), versión 3."
                        TextDecorations=""
                        TextElement.Foreground="Black">
                        Software libre (GPL-3).
                    </Hyperlink>
                </TextBlock>

                <TextBlock
                    TextWrapping="WrapWithOverflow"
                    Margin="3">
                    Cambios de esta build:
                    <Hyperlink
                        NavigateUri="https://github.com/danieltobon21/xmouse-controls"
                        TargetName="_blank"
                        RequestNavigate="Hyperlink_RequestNavigate">
                        danieltobon21/xmouse-controls
                    </Hyperlink>
                </TextBlock>
            </StackPanel>
        </Expander>
    </StackPanel>
</Window>
