<Project Sdk="Microsoft.NET.Sdk">

  <!--
    TobonMouse: build propia de X-Mouse Controls (Joel Purra, GPL-3).
    Cambios respecto al original: se apunta a .NET 8 (el original era .NET Framework 3.5, sin
    soporte y sin targeting packs en las maquinas modernas), icono y nombre propios, interfaz
    en espanol, bandeja del sistema y opcion de arrancar con Windows. El codigo de lectura y
    escritura de los ajustes (SystemParametersInfo) es el original sin cambios.
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <RootNamespace>XMouseControls</RootNamespace>
    <AssemblyName>TobonMouse</AssemblyName>
    <ApplicationIcon>Resources\tobonmouse.ico</ApplicationIcon>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Memoria: la app queda en la bandeja todo el dia, asi que se apaga el GC en segundo
         plano (ahorra un hilo y deja el heap mas pequeno) y se le pide que priorice devolver
         memoria en vez de reservarla (System.GC.ConserveMemory, mas abajo).
         OJO: nada de <InvariantGlobalization>true</InvariantGlobalization> aqui. WPF resuelve
         la cultura especifica de la ventana (en-us) al enlazar datos y, sin los datos de ICU,
         tira "Cannot find non-neutral culture related to 'en-us'" y el proceso muere al
         arrancar. Probado en esta maquina: la app no arranca con esa opcion. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\tobonmouse.ico" />
  </ItemGroup>

</Project>
